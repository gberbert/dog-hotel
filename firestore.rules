rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função auxiliar para verificar se é admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'lyoni.berbert@gmail.com' ||
        get(/databases/$(database)/documents/artifacts/doghotel-production/public/data/user_roles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ARQUIVOS DO APP
    match /artifacts/doghotel-production/public/data {
      
      // Coleção de Perfis (User Roles)
      match /user_roles/{userId} {
        // Qualquer usuário pode ler qualquer role (necessário pro admin panel e verificação)
        allow read: if isAuthenticated();
        // Apenas Admins podem alterar as roles
        allow write: if isAdmin() || (request.auth.uid == userId && !exists(/databases/$(database)/documents/artifacts/doghotel-production/public/data/user_roles/$(userId))); 
      }

      // Outras Coleções Públicas (Clients, Bookings...)
      match /{collectionName}/{docId} {
        allow read, write: if isAuthenticated();
      }
    }

    // REGRA DE NOTIFICAÇÕES
    match /artifacts/doghotel-production/system/notification_devices {
      allow read, write: if true; 
    }
  }
}